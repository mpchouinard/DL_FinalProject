# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Files our scripts generate. Ignored by name on purpose.
# Do not ignore the whole data folder. Git here is case insensitive, so a
# rule for "data/" would also match "Data/" and silently drop the paper
# CSVs a teammate adds next.
/data/pdb/
/data/labels.csv
/data/pairs.csv
/data/*.fasta

# Cached ESM-2 embeddings. Rebuild them with: python -m src.embed
/embeddings/

# Model checkpoints and arrays, too big for git.
/checkpoints/
*.pt
*.pth
*.npy
*.npz
*.h5

# Logs and experiment output
/logs/
/runs/
/wandb/
/outputs/
slurm-*.out

# Editors and OS
.vscode/
.idea/
.DS_Store
